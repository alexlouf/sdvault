{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SD-Vault",
  "version": "0.1.1",
  "identifier": "com.loufa.sd-vault",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SD-Vault v2",
        "width": 1150,
        "height": 800,
        "transparent": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
